# Copy to .env.local and fill in every value. The server refuses to start
# with any of these missing. Never commit .env.local.

# Persistent directory for the SQLite database and private evidence photos.
# In production this must be a volume that survives restarts and redeploys.
DATA_DIR=./data

# The single administrator account.
ADMIN_USERNAME=admin
# Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=

# At least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing it signs out every session.
SESSION_SECRET=
